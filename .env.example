# Copiar a .env.local fuera de Git. El modo stream simula el envío sin entregar correo.
HOST=127.0.0.1
PORT=3000
MAIL_TRANSPORT=stream
MAIL_FROM=
CONTACT_TO=contacto@csalma.cl
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=900000

# Preparado para Google Workspace SMTP (habilitar solo cuando se configuren credenciales reales).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Almacenamiento local y panel administrativo
DATA_DIR=data
ADMIN_ALLOW_REMOTE=false
IP_HASH_SALT=cambia-esta-sal-en-produccion
MONITOR_URL=https://csalma.cl
MONITOR_INTERVAL_MS=60000
MONITOR_ENABLED=true
ADMIN_FILES_WRITE=true

# Habilitar el formulario de contacto en build de producción (en desarrollo local siempre está activo).
VITE_CONTACT_FORM_ENABLED=false
